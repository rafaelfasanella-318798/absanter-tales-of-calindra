; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Absanter – Tales of Calindra"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SceneManager="*res://scripts/autoload/scene_manager.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
QuestManager="*res://scripts/autoload/quest_manager.gd"
InventoryManager="*res://scripts/autoload/inventory_manager.gd"
PartyManager="*res://scripts/autoload/party_manager.gd"
Localization="*res://scripts/autoload/localization.gd"
DebugConsole="*res://scenes/ui/debug_console.tscn"
DebugBoot="*res://scripts/autoload/debug_boot.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray()

